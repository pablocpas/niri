pkgbase = tiri
	pkgdesc = A tiling Wayland compositor derived from niri
	pkgver = 0.1.2
	pkgrel = 1
	url = https://github.com/pablocpas/tiri
	arch = x86_64
	license = GPL-3.0-or-later
	makedepends = clang
	makedepends = rust
	source = tiri-0.1.2.tar.gz::https://github.com/pablocpas/tiri/releases/download/tiri-v0.1.2/tiri-0.1.2.tar.gz
	source = tiri-0.1.2-vendored-dependencies.tar.xz::https://github.com/pablocpas/tiri/releases/download/tiri-v0.1.2/tiri-0.1.2-vendored-dependencies.tar.xz
	b2sums = SKIP
	b2sums = SKIP

pkgname = tiri
	depends = cairo
	depends = glib2
	depends = libdisplay-info
	depends = libinput
	depends = libpipewire
	depends = libxkbcommon
	depends = mesa
	depends = pango
	depends = pixman
	depends = seatd
	depends = systemd-libs
	depends = wayland
	depends = xdg-desktop-portal-impl
	optdepends = alacritty: suggested GPU-accelerated terminal emulator
	optdepends = bash: required by tiri-session
	optdepends = fuzzel: suggested Wayland application launcher
	optdepends = gnome-keyring: secrets portal provider configured by tiri-portals.conf
	optdepends = mako: suggested Wayland notification daemon
	optdepends = swaybg: suggested Wayland wallpaper tool
	optdepends = swaylock: suggested Wayland screen locker
	optdepends = waybar: suggested Wayland bar
	optdepends = xdg-desktop-portal-gnome: required for screencasting
	optdepends = xdg-desktop-portal-gtk: fallback portal configured by tiri-portals.conf
	optdepends = xwayland-satellite: required for running X11 applications
	provides = wayland-compositor
	conflicts = tiri-git
